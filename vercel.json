{
  "buildCommand": "vite build && npx esbuild src/server/vercelHandler.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
