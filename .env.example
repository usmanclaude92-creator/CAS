# Client-side (VITE_-prefixed vars are bundled into the app — never put
# secrets here, only the public anon key which Supabase RLS gates).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the CAS web app deployment (its Express server holds the
# service_role key needed for admin user-management endpoints). This app has
# no server of its own, so it calls that deployment for those endpoints only.
# Example: https://cas.yourcompany.com
VITE_ADMIN_API_URL=
