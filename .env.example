# Client-side (VITE_-prefixed vars are bundled into the browser build — never
# put secrets here, only the public anon key which Supabase RLS gates).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets (server.ts / Node process.env). NEVER prefix with VITE_
# — anything with that prefix is bundled into the client and becomes public.
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGIN=
ADMIN_NOTIFICATION_EMAIL=
PORT=3000
