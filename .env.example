# Client-side (VITE_-prefixed vars are bundled into the browser build — never
# put secrets here, only the public anon key which Supabase RLS gates).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave blank: this app is served by its own server.ts, so admin endpoints
# resolve as relative paths. Only set this for a client with no server of its
# own (see CAS-App/.env.example).
VITE_ADMIN_API_URL=

# Server-only secrets (server.ts / Node process.env). NEVER prefix with VITE_
# — anything with that prefix is bundled into the client and becomes public.
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGIN=
ADMIN_NOTIFICATION_EMAIL=
PORT=3000

# AI Agent (Phase 2, src/server/ai/providers/) — server-only, never VITE_-
# prefixed. The provider key is used exclusively inside src/server/ai/ to
# call the LLM API directly; it is never sent to the browser and the LLM
# itself never receives a database credential of any kind (see
# docs/ai/CAS-AI-PHASE-2.md).
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
